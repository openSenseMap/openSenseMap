{
	"exclude": [],
	"include": [
		"app/env.ts",
		"app/types.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".react-router/types/**/*"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "@react-router/node", "vite/client", "vite-plus/test/globals"],
		"isolatedModules": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"target": "ES2020",
		"strict": true,
		"allowJs": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"~/*": ["./app/*"],
			"@/*": ["./app/*"],
			"db/*": ["./db/*"],
			"emails/*": ["./emails/*"],
			"tests/*": ["./tests/*"]
		},
		"skipLibCheck": true,
		"rootDirs": [".", "./.react-router/types"],

		// Remix takes care of building everything in `remix build`.
		"noEmit": true
	}
}
