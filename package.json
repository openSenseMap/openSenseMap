{
  "name": "opensensemap",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "react-router dev",
    "build": "run-s build:*",
    "build:drizzle": "vp run db:generate",
    "build:react-router": "react-router build",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "db:check": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:setup": "vp run db:generate && vp run db:migrate",
    "db:seed": "tsx ./scripts/db/seed.ts",
    "db:seed-integrations": "tsx ./scripts/db/seed-integrations",
    "db:seed-orphan-user": "tsx ./scripts/db/seed-orphan-user",
    "device-schemas:alias-candidates": "node --experimental-strip-types ./scripts/device-schemas/generate-sensor-wiki-alias-candidates.ts",
    "email:dev": "email dev --dir app/emails",
    "components": "npx shadcn",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint:fix": "vp lint --fix",
    "typecheck": "react-router typegen && tsc"
  },
